# 依赖与构建产物（安装时需先 npm install && npm run build，见 README）
node_modules/
dist/

# 本仓库的参考源码（不入插件仓库版本库）
thirdparties/

# 目录约定：大写 Docs = 作者本地工作区（规划/设计/测试/参考，全部不入库）；
# 小写 docs = 随仓库发布的公开用户文档（GitHub 呈现为 docs/ 目录）。
# 注意：Windows 一个物理目录两种大小写引用；git 跟踪路径以小写 docs/ 为准（README 链接依赖）。
# 新增公开文档：文件放 docs/，并在下方补一条 !docs/文件名 放行。
Docs/*
!docs/
!docs/getting-started.md
!docs/configuration.md
!docs/troubleshooting.md
!docs/how-to-guides.md
!docs/testing.md
!docs/development.md

# workflow 运行时产物（journal、运行状态）；examples 的验收 workflow 脚本入库（自包含承诺）
.opencode-workflows/
!examples/sample-project/.opencode-workflows/
examples/sample-project/.opencode-workflows/*
!examples/sample-project/.opencode-workflows/workflows/

# 手工验收工程的运行时状态与本地测试脚本（不入库）；docs/ 下仅 10 个 mdx 验收语料入库（examples 自包含承诺），spec 笔记等本地文档忽略
examples/sample-project/.opencode/
examples/sample-project/.xflow/

# FFF 基准测试的运行产物与 thirdparties junction（不入库；src 是指向 thirdparties 的 junction）
examples/sample-project/benchmarks/results/
examples/sample-project/benchmarks/large-target/results/
examples/sample-project/benchmarks/large-target/src/
examples/sample-project/benchmarks/large-target/.opencode/
examples/sample-project/scripts/spec-clarify-workflow*
examples/sample-project/docs/*
!examples/sample-project/docs/*.mdx

# 日志与系统文件
*.log
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/
*.tsbuildinfo
demo-note.txt

# Claude Code 项目规则（本地，不入库；规则单源见 AGENTS.md）
CLAUDE.md
