{
  "name": "@mickorz/opencode-dynamic-workflows",
  "version": "0.2.1",
  "description": "OpenCode 动态工作流插件：Main Agent 生成 JS Workflow，Runtime 并行调度子会话，仅返回汇总结果",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src/tui",
    "skills",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencode-dynamic-workflows": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": "./src/tui/index.tsx"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.tui.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@opentui/solid": "^0.4.5",
    "acorn": "^8.16.0",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.12"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.27"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.27",
    "@opentui/core": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@types/acorn": "^6.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
